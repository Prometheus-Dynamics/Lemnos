# Device nodes the Lemnos daemon opens, given to its group. Generated by `lemnos-ctl tree
# --udev` from the board file: do not edit. Install as /usr/lib/udev/rules.d/71-lemnos-board.rules,
# beside packaging/udev/70-lemnos.rules. After a change, `udevadm control --reload` and
# `udevadm trigger` (or a reboot). The daemon refuses to start when a node it opens is not
# readable and writable by its group, and names the node.

# The kernel module's nodes: /dev/lemnos, and /dev/lemnos-<receiver> for each receiver the module owns (misc devices named by the module).
SUBSYSTEM=="misc", KERNEL=="lemnos", GROUP="lemnos", MODE="0660"
SUBSYSTEM=="misc", KERNEL=="lemnos-*", GROUP="lemnos", MODE="0660"

# The firmware mailbox the boot count is cleared through (/dev/vcio, a misc device): the slot driver's tryboot record.
SUBSYSTEM=="misc", KERNEL=="vcio", GROUP="lemnos", MODE="0660"

# The dma-heaps the board's drivers allocate from: the board file's [host] dma_heaps (default linux,cma), and every dma-buf stream's heap. Each is /dev/dma_heap/<name>.
SUBSYSTEM=="dma_heap", KERNEL=="linux,cma", GROUP="lemnos", MODE="0660"
