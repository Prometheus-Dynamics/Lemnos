# Generated by `lemnos-ctl tree --security-unit` from the board file's [security] table.
# Renders the security switch's view (/run/board/security) from its record before the daemon
# and the comm core start, and makes the places the daemon writes later: /run/board and the
# record's directory, owned by the daemon's user. Change the board file, not this unit.
[Unit]
Description=Lemnos: the board security view
DefaultDependencies=no
After=local-fs.target systemd-sysusers.service
Before=lemnosd.service lemnos-orion.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=lemnos
Group=lemnos
RuntimeDirectory=board
RuntimeDirectoryMode=0775
RuntimeDirectoryPreserve=yes
# Runs as the daemon's user, so /run/board and the record's directory are the daemon's, and
# systemd gives an existing record to it too. It reads one record and writes one file.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateUsers=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0022
IPAddressDeny=any
DevicePolicy=closed
StateDirectory=lemnos
StateDirectoryMode=0750
ExecStart=/usr/bin/lemnos-ctl security render --record "/var/lib/lemnos/security.rec" --dir /run/board

[Install]
WantedBy=sysinit.target
