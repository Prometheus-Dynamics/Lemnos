# Generated by lemnos-ctl tree --bridge-env from the board file. Do not edit.
# The bridge offers each gadget's bulk endpoints to the comm core as the link named
# after the `=`. The comm core must know a USB link by the same name.
LEMNOS_ORION_LINKS=gadget=orion-link
# The devices that take files pushed through Orion, and where each one's go. The unit
# drop-in --bridge-dropin writes grants exactly these directories.
LEMNOS_ORION_FILES=slots=/data/slots/.incoming
