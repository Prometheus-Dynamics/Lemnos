# The Orion bridge: publishes every device lemnosd serves to an Orion node. A lemnosd client, and
# an Orion client; it reads and writes no files. Installed as /usr/lib/systemd/system/lemnos-orion.service.
# Built from service/orion (binary lemnos-orion). See packaging/README.md.
#
# Runs as the lemnos user. It needs the lemnosd socket (group lemnos). It also needs the Orion node's
# socket (group orion, from Orion's own packaging): an image that ships Orion adds
# `SupplementaryGroups=orion` in a drop-in. Without it the unit starts and cannot reach the node.

[Unit]
Description=Lemnos bridge to Orion
Wants=lemnosd.service
After=lemnosd.service
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/lemnos-orion
EnvironmentFile=-/etc/lemnos/lemnosd.env
User=lemnos
Group=lemnos
TimeoutStopSec=15s
Restart=always
RestartSec=1s
RestartSteps=5
RestartMaxDelaySec=30s

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# AF_UNIX only: both sockets are local. Widen this only if a node is reached over TCP.
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
