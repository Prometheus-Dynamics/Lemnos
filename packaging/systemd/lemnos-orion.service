# The Orion bridge: publishes every device lemnosd serves to an Orion node. A lemnosd client, and
# an Orion client. It writes files only into the directories LEMNOS_ORION_FILES names, for the
# devices that take files sent through Orion; with ProtectSystem=strict a drop-in must add each as
# ReadWritePaths= (a slot device's .incoming is mode 0770, group lemnos, one of LEMNOS_ORION_GROUPS).
# Installed as /usr/lib/systemd/system/lemnos-orion.service.
# Built from service/orion (binary lemnos-orion). See packaging/README.md.
#
# Starts as root and drops to the identity in /etc/lemnos/lemnos-orion.env (LEMNOS_ORION_USER and
# its groups): the same root phase as lemnosd (service/orion/src/privilege.rs), keeping no capability. The
# groups are the daemon's (lemnos, for its socket) and the Orion node's; see that file.

[Unit]
Description=Lemnos bridge to Orion
Wants=lemnosd.service
After=lemnosd.service
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/lemnos-orion
EnvironmentFile=-/etc/lemnos/lemnos-orion.env
TimeoutStopSec=15s
Restart=always
RestartSec=1s

# The root phase needs the three id-changing capabilities; the bridge drops them all after the drop.
CapabilityBoundingSet=CAP_SETGID CAP_SETUID CAP_SETPCAP
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# AF_UNIX only: both sockets are local. Widen this only if a node is reached over TCP.
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service @setuid prctl
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
