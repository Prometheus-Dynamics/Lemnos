# /etc/lemnos/lemnosd.env: read by lemnosd.service and lemnos-orion.service (EnvironmentFile=-).
# Install as /etc/lemnos/lemnosd.env. Every line is optional; the defaults are shown in comments.
# Environment variables are read by lemnosd; a flag given in its ExecStart wins over them.

# The socket lemnosd listens on, and lemnos-ctl and lemnos-orion connect to.
# The unit's RuntimeDirectory is /run/lemnos, so keep the socket inside it.
#LEMNOSD_SOCKET=/run/lemnos/lemnosd.sock

# The board file is given on ExecStart (--board /etc/lemnos/board.toml). Setting LEMNOSD_BOARD
# here has no effect while ExecStart passes --board. The OS supplies the file; see docs/boards.md.
#LEMNOSD_BOARD=/etc/lemnos/board.toml

# Driver packages: off unless a directory is named. Signed mode is the default, against the keys
# in LEMNOSD_PACKAGE_KEYS. LEMNOSD_PACKAGE_MODE=open runs any package; do not set it on a board.
#LEMNOSD_PACKAGES=/usr/lib/lemnos/packages
#LEMNOSD_PACKAGE_KEYS=/etc/lemnos/package-keys.pub
#LEMNOSD_PACKAGE_MODE=signed

# lemnos-orion only: the Orion node this board publishes as. Unset means node.local.
#ORION_NODE_ID=node.local
