# /etc/default/lemnosd.env: settings for lemnosd.service.
#
# Plain KEY=value lines (systemd EnvironmentFile syntax). Assignments here
# override the Environment= defaults in the unit. Restart after editing:
# `systemctl restart lemnosd`.

# The board definition (TOML or JSON), installed by the device package.
#LEMNOSD_BOARD=/etc/lemnos/board.toml

# The socket clients connect to (lemnos-ctl --socket, DeviceClient::connect).
#LEMNOSD_SOCKET=/run/lemnos/lemnosd.sock

# The device package's update status; `off` keeps updates off the LEDs.
#LEMNOSD_UPDATE_STATUS=/run/pd-device/update.json

# Show the booting spinner for this long after start, or until a client sets
# a status (0: off).
#LEMNOSD_BOOTING_MS=30000
