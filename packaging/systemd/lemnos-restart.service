# The restart helper (RESTART-UNIT). Installed as /usr/lib/systemd/system/lemnos-restart.service, started by
# lemnos-restart.socket. See packaging/README.md, "The restart helper".
#
# It runs as root because only root may ask the service manager for reboot.target without polkit. It takes one
# line, "check <nonce>" or "reboot <nonce>", from root or user lemnos, and talks to the service manager over its
# private socket. It needs no capability: a uid-0 peer of /run/systemd/private is trusted by the manager.

[Unit]
Description=Lemnos: the restart helper
Requires=lemnos-restart.socket
After=lemnos-restart.socket

[Service]
Type=simple
ExecStart=/usr/bin/lemnos-restart --user lemnos
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
