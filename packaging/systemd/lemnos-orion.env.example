# /etc/lemnos/lemnos-orion.env: read by lemnos-orion.service and by S51lemnos-orion. Lines are
# shell-sourceable. Install as /etc/lemnos/lemnos-orion.env. See packaging/README.md, "The Orion bridge".

# The Orion node this board publishes as. Unset means node.local.
#ORION_NODE_ID=node.local

# The comm core to publish to, as Orion writes an address. Unset means the board's own comm core.
#ORION_ADDRESS=

# lemnosd's socket. The daemon makes it in its runtime directory, /run/lemnos.
#LEMNOSD_SOCKET=/run/lemnos/lemnosd.sock

# The identity the bridge drops to after it starts as root: the `lemnos-orion` user from lemnos.conf.
LEMNOS_ORION_USER=lemnos-orion
LEMNOS_ORION_GROUP=lemnos-orion
# Supplementary groups, comma-separated: lemnos (lemnosd's socket and the slot's .incoming directory)
# and the Orion node's group. The image sets the Orion node's group name. The example uses `orion`.
LEMNOS_ORION_GROUPS=lemnos,orion
