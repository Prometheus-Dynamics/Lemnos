# The good-boot deadline (M36): a boot that is not good within the board's deadline is restarted.
# Installed as /usr/lib/systemd/system/lemnos-good-boot.service. See docs/slots.md, "The good-boot deadline".
#
# A boot is good when lemnosd has reached ready and the booted marker names a slot. This unit has no
# dependency on lemnosd: it is outside lemnosd, so it decides when lemnosd is wedged or never starts.
# lemnosd.service is not changed for it (it keeps Restart=always and no failure action).
#
# It runs only on a board that has a system-slots device: `lemnos-ctl tree --good-boot-unit` writes that
# board's drop-in, which holds the deadline, and the condition below is that drop-in. Change the board file,
# not this unit or the drop-in.

[Unit]
Description=Lemnos: a good boot within the deadline, or a restart
ConditionPathExists=/etc/systemd/system/lemnos-good-boot.service.d/deadline.conf
After=local-fs.target
# A deadline that passes (the unit fails) reboots the board. reboot-force makes systemd reboot at once,
# without stopping the units first: lemnosd is the one that may be wedged, and its stop (up to its
# TimeoutStopSec) would hold the reboot. Each state file is replaced whole and synced, so nothing is
# left half-written by it.
FailureAction=reboot-force

[Service]
Type=oneshot
# The deadline. The drop-in gives both the command's --deadline-s and this timeout, the same value.
ExecStart=/usr/bin/lemnos-good-boot --deadline-s 300
TimeoutStartSec=300
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
