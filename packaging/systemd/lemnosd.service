# The Lemnos daemon: owns the hardware, serves every program over one Unix socket.
# Installed as /usr/lib/systemd/system/lemnosd.service. See packaging/README.md.
#
# Starts as root and drops to the lemnos user itself (`--user lemnos --group lemnos`): the root phase
# runs the privileged start, then lemnosd keeps only CAP_SYS_RAWIO (service/lemnosd/src/privilege.rs).
# The unit gives it no User= and no AmbientCapabilities=. Device nodes are reached through group
# `lemnos` (packaging/udev/70-lemnos.rules).
# Change this unit with a drop-in (/etc/systemd/system/lemnosd.service.d/*.conf), not an edited copy.
# The hardware watchdog belongs to lemnosd alone (its hw-watchdog driver opens it: one opener). The
# OS must not set RuntimeWatchdogSec= or ShutdownWatchdogSec= in /etc/systemd/system.conf, which
# would have systemd open the same device.

[Unit]
Description=Lemnos hardware daemon
# The board file is the OS's: /etc/lemnos/board.toml. Without it there is nothing to run.
ConditionPathExists=/etc/lemnos/board.toml
StartLimitIntervalSec=0

[Service]
# Type=notify: lemnosd sends READY=1 once every driver is started and the socket listens. The
# unit has no WatchdogSec=: the hardware watchdog is the escalation (see "Restart" below).
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/lemnosd --board /etc/lemnos/board.toml --user lemnos --group lemnos
# Settings for the daemon's environment: socket, packages, package keys. Optional. A flag in
# ExecStart (--board here) wins over its environment variable.
EnvironmentFile=-/etc/lemnos/lemnosd.env

# /run/lemnos: systemd makes it (root-owned, as the unit has no User=); the root phase hands it to
# lemnos:lemnos before the drop. lemnosd makes the socket at start and removes it at stop. Clients in
# group lemnos may open the directory and connect to the socket.
RuntimeDirectory=lemnos
RuntimeDirectoryMode=0750

# Stop is for shutdown only. It drops every driver; the hardware watchdog then reboots a board that
# is still running, so the unit is never stopped on a live board.
TimeoutStopSec=30s

# lemnosd must not stay down. It is restarted at once, with a constant delay: no growing delay, no
# start limit. 1 s is the shortest delay that cannot spin on a daemon that dies at start. The
# hardware watchdog (hw-watchdog, on by default on a managed board, 15 s) reboots the board if the
# daemon is not back in time. So the restart, including startup, must come well inside 15 s.
Restart=always
RestartSec=1s

# Kept with the daemon: only the one capability, for the module's register mapping.
# The root phase needs these five; the daemon drops every other one from its own bounding set after
# the drop, so this list is only what starts it. CAP_SYS_RAWIO is the one it keeps.
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID CAP_SETPCAP CAP_SYS_RAWIO
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Not PrivateDevices=: the device nodes are the daemon's whole job. Not PrivateNetwork=: the
# kernel's uevent socket is the host network namespace's.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# AF_UNIX: the socket. AF_NETLINK: the kernel's uevent socket for hotplug. Nothing else.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# The root phase's calls on top of @system-service: the id changes (@setuid), the owner of the
# runtime directory (@chown), and prctl for the capability and no_new_privs settings.
SystemCallFilter=@system-service @setuid @chown prctl
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
