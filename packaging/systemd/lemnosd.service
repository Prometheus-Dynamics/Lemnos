# The Lemnos daemon: owns the hardware, serves every program over one Unix socket.
# Installed as /usr/lib/systemd/system/lemnosd.service. See packaging/README.md.
#
# Starts as root and drops to the lemnos user itself (`--user lemnos --group lemnos`): the root phase
# runs the privileged start, then lemnosd keeps only CAP_SYS_RAWIO (service/lemnosd/src/privilege.rs).
# The unit gives it no User= and no AmbientCapabilities=. Device nodes are reached through group
# `lemnos` (packaging/udev/70-lemnos.rules). The unit sets no DevicePolicy, so a node is reached by its
# group grant alone. Every grant, its driver and its unit or udev line is in packaging/systemd/grants.toml,
# which scripts/check-unit-grants.py checks against the drivers.
# Change this unit with a drop-in (/etc/systemd/system/lemnosd.service.d/*.conf), not an edited copy.
# The hardware watchdog has two openers, in order: slot-init (the initramfs, until its exec) and then
# lemnosd's hw-watchdog driver (docs/slots.md, "The watchdog chain"). The OS must not set
# RuntimeWatchdogSec= or ShutdownWatchdogSec= in /etc/systemd/system.conf, which would have systemd
# open the same device and feed it while lemnosd is dead.

[Unit]
Description=Lemnos hardware daemon
# The board file is the OS's: /etc/lemnos/board.toml. Without it there is nothing to run.
ConditionPathExists=/etc/lemnos/board.toml
StartLimitIntervalSec=0
# Minimal ordering, in place of the implicit ones (DefaultDependencies=no). The implicit After=basic.target
# and Requires=sysinit.target would start lemnosd after every sysinit unit, which widens the unfed gap
# between slot-init's exec and lemnosd's root-phase feed (docs/slots.md, "The watchdog chain", window 4).
# lemnosd needs only the sysusers step (the `lemnos` user and group) before it starts. It does not wait
# for local-fs.target: a filesystem check (systemd-fsck) runs before that target, and must never run in the
# gap. The image mounts what lemnosd uses before switch_root, or without a check pass (docs/slots.md).
# A stop at shutdown stays as the implicit ordering gave it.
DefaultDependencies=no
After=systemd-sysusers.service
Conflicts=shutdown.target
Before=shutdown.target
# The daemon's restarts go through the root restart helper on this socket (packaging/README.md, "The restart helper").
# Wants only, no After: the socket's own default ordering (sockets.target, after sysinit) must not widen the gap
# above. The helper is needed only when a restart is asked for, long after the socket is listening.
Wants=lemnos-restart.socket

[Service]
# Type=notify: lemnosd sends READY=1 once every driver is started and the socket listens. The
# unit has no WatchdogSec=: the hardware watchdog is the escalation (see "Restart" below).
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/lemnosd --board /etc/lemnos/board.toml --user lemnos --group lemnos
# Settings for the daemon's environment: socket, packages, package keys. Optional. A flag in
# ExecStart (--board here) wins over its environment variable.
EnvironmentFile=-/etc/lemnos/lemnosd.env

# /run/lemnos: systemd makes it (root-owned, as the unit has no User=); the root phase hands it to
# lemnos:lemnos before the drop. lemnosd makes the socket at start and removes it at stop. Clients in
# group lemnos may open the directory and connect to the socket. The directory is kept across the
# daemon's restarts (automatic or `systemctl restart`) and removed by a stop: it holds the slots driver's
# boot-good mark (docs/slots.md, "Boot good once a boot"), which names the kernel's boot id, so a restarted
# daemon doesn't verify and clear again what this boot already did. The mark does not tell a restart from a
# first start; the descriptor store below is still the only marker of a restart.
RuntimeDirectory=lemnos
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
# The file descriptor store keeps the hardware watchdog's descriptor across a restart (docs/slots.md,
# "The watchdog chain", window 5). lemnosd stores the one its root phase opened and fed, and the next start
# takes it back and feeds nothing: opening a running watchdog feeds it. It also keeps each bound USB
# gadget's FunctionFS files, so a restart leaves the gadget on the bus and its network link up
# (docs/daemon.md, "The USB gadget across a restart"). The store is emptied by a stop, so a start after one is
# the first start. It is not kept across a failed unit (the watchdog then resets the board). 64 holds the
# keep-alive watchdogs and a gadget's record, ep0 and every endpoint file FunctionFS allows (30).
FileDescriptorStoreMax=64

# Stop is for shutdown only. It drops every driver; the hardware watchdog then reboots a board that
# is still running, so the unit is never stopped on a live board. The stop bound is under the shortest
# time the watchdog can leave after the daemon's last feed (15 s period, fed every 7.5 s: 7.5 s), so a
# stop that hangs at shutdown is killed and the shutdown goes on, rather than the watchdog rebooting a
# board that was powering off (see "The hardware watchdog" in packaging/README.md).
TimeoutStopSec=5s

# lemnosd must not stay down. It is restarted at once, with a constant delay: no growing delay, no
# start limit. 1 s is the shortest delay that cannot spin on a daemon that dies at start. The
# hardware watchdog (hw-watchdog, on by default on a managed board, 15 s) reboots the board if the
# daemon is not back in time. So the restart, including startup, must come well inside 15 s.
Restart=always
RestartSec=1s

# Kept with the daemon: only the one capability, for the module's register mapping.
# The root phase needs these five; the daemon drops every other one from its own bounding set after
# the drop, so this list is only what starts it. CAP_SYS_RAWIO is the one it keeps. A gadget board's
# fragment adds CAP_SYS_ADMIN for the FunctionFS mount, which the drop also removes.
CapabilityBoundingSet=CAP_CHOWN CAP_SETGID CAP_SETUID CAP_SETPCAP CAP_SYS_RAWIO
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# A board with a USB gadget takes the optional fragment packaging/systemd/lemnosd.service.d/gadget.conf
# as a drop-in: the capability and the mount calls its FunctionFS mount needs, and the configfs path.
# Not PrivateDevices=: the device nodes are the daemon's whole job. Not PrivateNetwork=: the
# kernel's uevent socket is the host network namespace's.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# AF_UNIX: the socket. AF_NETLINK: the kernel's uevent socket for hotplug. Nothing else. A board
# with a `tcp:` health source takes the optional fragment lemnosd.service.d/health-tcp.conf, which
# adds the two Internet families for that connect.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# The root phase's calls on top of @system-service: the id changes (@setuid), the owner of the
# runtime directory (@chown), and prctl for the capability and no_new_privs settings. A gadget board's
# fragment adds the FunctionFS mount and its unmount.
SystemCallFilter=@system-service @setuid @chown prctl
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
