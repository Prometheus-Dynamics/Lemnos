# lemnosd as a managed systemd service: the board's hardware service.
#
# Needs /usr/bin/lemnosd and /usr/bin/lemnos-ctl, the `lemnos` system user
# from lemnos.sysusers, and a board definition at /etc/lemnos/board.toml
# (installed by the board's device package). Settings go in
# /etc/default/lemnosd.env; local changes to this unit belong in drop-ins
# (`systemctl edit lemnosd`). Units that must start after lemnosd go in a
# drop-in (packaging/systemd/lemnosd.service.d/order.conf.example). See packaging/README.md.

[Unit]
Description=Lemnos hardware service
Documentation=https://github.com/Prometheus-Dynamics/Lemnos/blob/dev/docs/system-service.md
# Early: once the I2C, PIO, GPIO and hwmon drivers are bound, before the
# services that use the hardware.
After=systemd-modules-load.service systemd-udevd.service
StartLimitIntervalSec=0

[Service]
# READY=1 once the board's devices are built and the socket listens.
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/lemnosd
# SIGHUP re-reads the look files (LEMNOSD_LOOKS_DIR, LEMNOSD_LOOKS_OVERRIDE_DIR).
ExecReload=/bin/kill -HUP $MAINPID
# Fans go back to the kernel however the service ends, including SIGKILL and
# the watchdog's SIGABRT. `+` runs it as root: the thermal cooling devices it
# re-applies (`cur_state`) are root-owned. It reads the plans lemnosd
# recorded in /run/lemnos/fan-restore.
ExecStopPost=+/usr/bin/lemnos-ctl fan restore --all

# The loop pings every WatchdogSec/2 while it keeps completing passes.
WatchdogSec=10s
TimeoutStartSec=60s
TimeoutStopSec=10s

Restart=always
RestartSec=1s
RestartSteps=5
RestartMaxDelaySec=10s

Environment=LEMNOSD_BOARD=/etc/lemnos/board.toml
Environment=LEMNOSD_SOCKET=/run/lemnos/lemnosd.sock
EnvironmentFile=-/etc/default/lemnosd.env

# A fixed user so clients get access through the `lemnos` group. The device
# groups give access to /dev/i2c-*, /dev/gpiochip* and /dev/leds*; sysfs fan
# and hwmon files need a udev rule or the root-owned defaults the device
# package sets (see packaging/README.md).
User=lemnos
Group=lemnos
SupplementaryGroups=i2c gpio video

# /run/lemnos holds the socket: group-connectable for `lemnos` members.
RuntimeDirectory=lemnos
RuntimeDirectoryMode=0750
# The writable look directory (LEMNOSD_LOOKS_OVERRIDE_DIR, `looks save`), owned by lemnos.
StateDirectory=lemnos
UMask=0007

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# The scheduling class is set by systemd before exec, so RestrictRealtime still
# stops the service changing it later. Fixed priority 10 sits below the kernel's
# interrupt threads (50) and inside the default real-time throttle (95 %), and
# lemnosd sleeps between reads, so it takes the CPU only when a read is due.
# Without it, a loaded board makes the poll loop wait for a CPU and it skips
# samples: four busy loops at nice -5 cost 43 of 12 000 IMU samples at 200 Hz
# (Nice=-10: 33); with it, none (docs/system-service.md, "Scheduling under load").
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=10
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Writes to sysfs (fan pwm, LED device) need these paths writable.
ReadWritePaths=/sys/class/hwmon /sys/devices /dev
# Not set: PrivateDevices= (hides /dev/i2c-*), ProtectKernelTunables= (makes
# /sys read-only: fans could not be written).

[Install]
WantedBy=multi-user.target
