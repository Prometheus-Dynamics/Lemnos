#!/bin/sh
# /etc/init.d/S49lemnos-restart: runs the restart helper (lemnos-restart) under BusyBox init, before lemnosd.
# Installed as /etc/init.d/S49lemnos-restart (mode 0755). rcS runs it with "start" at boot.
# Usage: S49lemnos-restart {start|stop|restart|status}
#
# The daemon drops to user lemnos, which may not signal init. It asks this root helper on HELPER_SOCKET
# instead ("check <nonce>" or "reboot <nonce>"); the helper restarts the board with SIGTERM to process 1,
# which BusyBox init takes as a restart (packaging/README.md, "The restart helper"). The helper makes its
# socket itself: root's, group lemnos, mode 0660. The supervisor starts it again after RESTART_DELAY seconds
# when it exits, never giving up. `stop` is for shutdown: TERM, then KILL after STOP_TIMEOUT seconds.
#
# Plain POSIX sh: it must run under BusyBox ash.

SELF=/etc/init.d/S49lemnos-restart
HELPER=/usr/bin/lemnos-restart
STOP_TIMEOUT=10
# Seconds between the helper's exit and its next start. Constant.
RESTART_DELAY=1
HELPER_SOCKET=/run/lemnos-restart.sock
PIDDIR=/run/lemnos-restart
PIDFILE=$PIDDIR/supervisor.pid
CHILDFILE=$PIDDIR/helper.pid
LOG=/var/log/lemnos-restart.log

# The supervisor. Runs as root, under start-stop-daemon.
supervise() {
  stopping=0
  child=
  killer=
  trap on_term TERM INT
  echo $$ >"$PIDFILE"
  while [ "$stopping" = 0 ]; do
    "$HELPER" --user lemnos --init --listen "$HELPER_SOCKET" &
    child=$!
    echo "$child" >"$CHILDFILE"
    wait "$child"
    rc=$?
    # wait returns early when TERM arrives: the helper may still be running until it exits.
    while kill -0 "$child" 2>/dev/null; do
      sleep 1
    done
    child=
    rm -f "$CHILDFILE"
    [ "$stopping" = 0 ] || break
    echo "$(date): lemnos-restart exited with status $rc; starting again in ${RESTART_DELAY}s"
    sleep "$RESTART_DELAY" &
    wait $!
  done
  if [ -n "$killer" ]; then kill "$killer" 2>/dev/null; fi
  rm -f "$PIDFILE" "$CHILDFILE"
}

on_term() {
  stopping=1
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null
    # Bounded: if the helper has not gone after STOP_TIMEOUT seconds, it is killed.
    ( sleep "$STOP_TIMEOUT"; kill -KILL "$child" 2>/dev/null ) &
    killer=$!
  fi
}

# The supervisor's pid, if it is running.
running_pid() {
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

start() {
  if running_pid >/dev/null; then
    echo "lemnos-restart already running"
    return 0
  fi
  if [ ! -x "$HELPER" ]; then
    echo "lemnos-restart: no program at $HELPER; not starting" >&2
    return 1
  fi
  if ! command -v start-stop-daemon >/dev/null 2>&1; then
    echo "lemnos-restart: needs start-stop-daemon (BusyBox with CONFIG_START_STOP_DAEMON)" >&2
    return 1
  fi
  mkdir -p "$PIDDIR" || return 1
  touch "$LOG" || return 1
  rm -f "$PIDFILE" "$CHILDFILE"
  start-stop-daemon -S -b -x "$SELF" -- supervise >>"$LOG" 2>&1 || {
    echo "lemnos-restart: could not start the supervisor" >&2
    return 1
  }
  echo "lemnos-restart started (log $LOG)"
  return 0
}

stop() {
  pid=$(cat "$PIDFILE" 2>/dev/null)
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PIDFILE"
    child=$(cat "$CHILDFILE" 2>/dev/null)
    if [ -n "$child" ] && kill -0 "$child" 2>/dev/null; then
      kill -KILL "$child" 2>/dev/null
    fi
    rm -f "$CHILDFILE"
    echo "lemnos-restart not running"
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null
  i=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$i" -ge $((STOP_TIMEOUT + 5)) ]; then
      kill -KILL "$pid" 2>/dev/null
      child=$(cat "$CHILDFILE" 2>/dev/null)
      [ -n "$child" ] && kill -KILL "$child" 2>/dev/null
      break
    fi
    sleep 1
    i=$((i + 1))
  done
  rm -f "$PIDFILE" "$CHILDFILE"
  echo "lemnos-restart stopped"
  return 0
}

status() {
  pid=$(running_pid) || {
    echo "lemnos-restart is not running"
    return 3
  }
  child=$(cat "$CHILDFILE" 2>/dev/null)
  echo "lemnos-restart is running (supervisor $pid, helper ${child:-none})"
  return 0
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  status) status ;;
  supervise) supervise ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 1
    ;;
esac
