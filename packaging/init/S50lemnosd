#!/bin/sh
# /etc/init.d/S50lemnosd: runs lemnosd under BusyBox init, where there is no systemd.
# Installed as /etc/init.d/S50lemnosd (mode 0755). rcS runs it with "start" at boot.
# Usage: S50lemnosd {start|stop|restart|status}
#
# The daemon runs as user and group lemnos (packaging/README.md, "Without systemd"). `start` runs as
# root only to make the runtime directory and the log, then starts a supervisor as lemnos with
# start-stop-daemon. The supervisor runs lemnosd and starts it again after RESTART_DELAY seconds when
# it exits. `stop` is for shutdown: it sends TERM, then KILLs after STOP_TIMEOUT seconds.
# The hardware watchdog is the escalation; this script does not feed it (lemnosd does).
#
# Plain POSIX sh: it must run under BusyBox ash.

SELF=/etc/init.d/S50lemnosd
DAEMON=/usr/bin/lemnosd
BOARD=/etc/lemnos/board.toml
ENVFILE=/etc/lemnos/lemnosd.env
RUN_USER=lemnos:lemnos
STOP_TIMEOUT=10
# Seconds between a daemon's exit and its next start. Constant, and well inside the hardware watchdog's
# bound (15 s): a restart that takes longer than that reboots the board.
RESTART_DELAY=1

# The settings file, as systemd's EnvironmentFile= reads it. Every line is optional.
if [ -r "$ENVFILE" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$ENVFILE"
  set +a
fi
SOCKET=${LEMNOSD_SOCKET:-/run/lemnos/lemnosd.sock}
RUNDIR=$(dirname "$SOCKET")
PIDFILE=$RUNDIR/supervisor.pid
CHILDFILE=$RUNDIR/lemnosd.pid
LOG=/var/log/lemnosd.log

# The supervisor. Runs as lemnos, under start-stop-daemon. It keeps lemnosd running: a daemon that
# exits is started again after RESTART_DELAY seconds, a constant delay, never giving up. The
# hardware watchdog reboots the board if lemnosd is not back in time, so this delay stays short.
supervise() {
  stopping=0
  child=
  killer=
  trap on_term TERM INT
  echo $$ >"$PIDFILE"
  while [ "$stopping" = 0 ]; do
    "$DAEMON" --board "$BOARD" &
    child=$!
    echo "$child" >"$CHILDFILE"
    wait "$child"
    rc=$?
    # wait returns early when TERM arrives: the daemon may still be running until it exits.
    while kill -0 "$child" 2>/dev/null; do
      sleep 1
    done
    child=
    rm -f "$CHILDFILE"
    [ "$stopping" = 0 ] || break
    echo "$(date): lemnosd exited with status $rc; starting again in ${RESTART_DELAY}s"
    sleep "$RESTART_DELAY" &
    wait $!
  done
  if [ -n "$killer" ]; then kill "$killer" 2>/dev/null; fi
  rm -f "$PIDFILE" "$CHILDFILE"
}

on_term() {
  stopping=1
  if [ -n "$child" ]; then
    kill -TERM "$child" 2>/dev/null
    # Bounded: if the daemon has not gone after STOP_TIMEOUT seconds, it is killed.
    ( sleep "$STOP_TIMEOUT"; kill -KILL "$child" 2>/dev/null ) &
    killer=$!
  fi
}

# The supervisor's pid, if it is running.
running_pid() {
  pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  echo "$pid"
}

start() {
  if running_pid >/dev/null; then
    echo "lemnosd already running"
    return 0
  fi
  if [ ! -r "$BOARD" ]; then
    echo "lemnosd: no board file at $BOARD; not starting" >&2
    return 1
  fi
  if ! command -v start-stop-daemon >/dev/null 2>&1; then
    echo "lemnosd: needs start-stop-daemon (BusyBox with CONFIG_START_STOP_DAEMON)" >&2
    return 1
  fi
  # The runtime directory is the socket's, owned by lemnos, as RuntimeDirectory= makes it.
  mkdir -p "$RUNDIR" || return 1
  chown lemnos:lemnos "$RUNDIR" && chmod 0750 "$RUNDIR" || return 1
  touch "$LOG" && chown lemnos:lemnos "$LOG" || return 1
  rm -f "$PIDFILE" "$CHILDFILE"
  start-stop-daemon -S -b -c "$RUN_USER" -x "$SELF" -- supervise >>"$LOG" 2>&1 || {
    echo "lemnosd: could not start the supervisor" >&2
    return 1
  }
  # Give the socket a few seconds. If it is not up, the daemon is still being retried.
  i=0
  while [ ! -S "$SOCKET" ] && [ "$i" -lt 10 ] && running_pid >/dev/null; do
    sleep 1
    i=$((i + 1))
  done
  if [ -S "$SOCKET" ]; then
    echo "lemnosd started, socket $SOCKET"
  else
    echo "lemnosd started; the socket is not up yet (see $LOG)"
  fi
  return 0
}

stop() {
  pid=$(cat "$PIDFILE" 2>/dev/null)
  if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PIDFILE"
    # A daemon left by a dead supervisor is stopped too, so that nothing holds the hardware.
    child=$(cat "$CHILDFILE" 2>/dev/null)
    if [ -n "$child" ] && kill -0 "$child" 2>/dev/null; then
      kill -KILL "$child" 2>/dev/null
    fi
    rm -f "$CHILDFILE"
    rm -f "$SOCKET"
    echo "lemnosd not running"
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null
  i=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$i" -ge $((STOP_TIMEOUT + 5)) ]; then
      kill -KILL "$pid" 2>/dev/null
      child=$(cat "$CHILDFILE" 2>/dev/null)
      [ -n "$child" ] && kill -KILL "$child" 2>/dev/null
      break
    fi
    sleep 1
    i=$((i + 1))
  done
  rm -f "$PIDFILE" "$CHILDFILE" "$SOCKET"
  echo "lemnosd stopped"
  return 0
}

status() {
  pid=$(running_pid) || {
    echo "lemnosd is not running"
    return 3
  }
  child=$(cat "$CHILDFILE" 2>/dev/null)
  echo "lemnosd is running (supervisor $pid, daemon ${child:-none}), socket $SOCKET"
  return 0
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  status) status ;;
  supervise) supervise ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 1
    ;;
esac
