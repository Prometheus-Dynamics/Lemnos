{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Prometheus-Dynamics/Lemnos/docs/schemas/lemnos-board.schema.json",
  "title": "Lemnos board definition",
  "description": "A board's devices, each built from a generic Lemnos driver. TOML or JSON; see docs/board-definition.md. Driver-specific checks (config keys, values) are done by lemnos-board's DriverRegistry::validate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "board"
  ],
  "properties": {
    "format": {
      "const": "lemnos.board"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        }
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/device"
      }
    },
    "lines": {
      "type": "array",
      "description": "Named GPIO lines no device owns, for clients' raw claims.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "chip",
          "line"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/id"
          },
          "chip": {
            "type": "string",
            "description": "gpiochipN or a chip label (pinctrl-rp1)."
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "safe": {
            "enum": [
              "input",
              "low",
              "high"
            ],
            "default": "input",
            "description": "What the line goes back to when a claim ends."
          }
        }
      }
    },
    "pwms": {
      "type": "array",
      "description": "Named PWM channels no device owns, for clients' raw claims.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "chip",
          "channel"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/id"
          },
          "chip": {
            "type": "integer",
            "minimum": 0,
            "description": "The pwmchipN number."
          },
          "channel": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "raw_clients": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Clients allowed raw bus and line access; empty: any client."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "driver"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "driver": {
          "type": "string",
          "description": "Built-in: bmi088, bmm150, ina226, ina238, ina260, vcm, hwmon-fan, thermal-zone (hosts may register more)."
        },
        "label": {
          "type": "string"
        },
        "backend": {
          "enum": [
            "auto",
            "userspace",
            "kernel"
          ],
          "default": "auto"
        },
        "bus": {
          "type": "string",
          "description": "\"i2c-<n>\", \"i2c:<key>=<value>[;<key>=<value>...]\" (keys: name, compatible, of, node) or \"spi-<bus>.<cs>\".",
          "pattern": "^(i2c-[0-9]+|i2c:(name|compatible|of|node)=[^;]+(;(name|compatible|of|node)=[^;]+)*|pio-i2c:sda=[0-9]+,scl=[0-9]+(,hz=[0-9]+)?|spi-[0-9]+\\.[0-9]+)$"
        },
        "address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "path": {
          "type": "string"
        },
        "match": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "poll_ms": {
          "type": "integer",
          "minimum": 1
        },
        "writers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value"
          }
        },
        "raw": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Clients allowed raw I2C/SPI transactions to this device's addresses (brokered by the host); empty: none. Lines and PWM channels a device owns are never handed out raw."
        }
      }
    },
    "value": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        }
      ]
    }
  }
}
