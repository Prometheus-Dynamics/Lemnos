ccflags-y := -Werror
# Set by the test harness, to build the PIO file against a stand-in for the driver.
ccflags-y += $(LEMNOS_EXTRA_CFLAGS)

# Out of tree (make -C <kernel> M=...): a module, as before. Built into a kernel tree (this directory
# as drivers/misc/lemnos/, see docs/kernel-config.md): CONFIG_LEMNOS decides, built in (y) or a module (m).
ifneq ($(KBUILD_EXTMOD),)
obj-m += lemnos.o
else
obj-$(CONFIG_LEMNOS) += lemnos.o
endif
lemnos-y := lemnos_core.o lemnos_claims.o lemnos_stream.o lemnos_rp1_csi2.o lemnos_pisp_be.o lemnos_pisp_fe.o lemnos_gsdma.o lemnos_vip.o lemnos_regjob.o lemnos_regjob_a733.o lemnos_regjob_k230isp.o lemnos_bus.o lemnos_gpio.o lemnos_pwm.o lemnos_power.o lemnos_events.o
# The PIO file only exists for a kernel that has the RP1 PIO driver, built in or as a module.
# A built-in lemnos needs RP1_PIO=y as well: a built-in object cannot link to a module's symbols.
ifneq ($(CONFIG_RP1_PIO),)
ccflags-y += -DLEMNOS_HAVE_PIO
lemnos-y += lemnos_pio.o
endif
