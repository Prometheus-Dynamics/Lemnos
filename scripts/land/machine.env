# This machine's lander profile: what scripts/land/setup writes into land.env besides the paths (which it
# derives from --base and --repo). CPU sets inside the machine's cap of 6-31; cargo jobs at most 13.
LAND_REMOTE=origin
LAND_PR_REPO=Prometheus-Dynamics/Lemnos
LAND_UNIT_PREFIX=ltrain-
LAND_CPUS_GATE=6-21
LAND_CPUS_CC=6-21
LAND_CPUS_QEMU=22-27
LAND_CPUS_OFF=28-31
LAND_JOBS_GATE=12
LAND_JOBS_KERNEL=12
LAND_JOBS_QEMU=8
LAND_JOBS_QEMU_CARGO=4
LAND_JOBS_OFF=6
LAND_JOBS_CC=4
