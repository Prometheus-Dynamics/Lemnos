# Machine settings for the lander (scripts/land/). scripts/land/setup writes this file for this machine from
# machine.env; on another machine, copy this file outside the repository, fill in every value, and export
# LEMNOS_LAND_ENV=<that copy> before running land.sh. The lander refuses to start when
# LEMNOS_LAND_ENV is unset or missing, and names every variable that is not set.
#
# Plain shell assignments, one per line, no spaces around "=". Placeholders are shown in /path/to form.

# The Lemnos checkout the lander reads. It is fetched into and the stack worktree is added from it; nothing
# is built in it.
LAND_REPO=/path/to/lemnos-checkout

# The stack worktree: detached, reset to the base at every train. It must not hold work of your own.
LAND_WORKTREE=/path/to/lander-worktree

# State: one directory per train (its logs, the consumer-compile log), the counter, green marks,
# ndf-record.tsv, and run-<unit>.log for each unit.
LAND_STATE_DIR=/path/to/lander-state

# Working directory of the systemd unit. Any directory that exists.
LAND_UNIT_DIR=/path/to/lander-state

# The flock file that serializes trains on this stack. Use one file per stack.
LAND_LOCK_FILE=/path/to/lander-state/lock.stack

# Scratch for the QEMU harness target, the modules-off target and the gate's parts. Needs free space.
LAND_SCRATCH=/path/to/lander-scratch

# Base directory for each train's TMPDIR (train-<n> is made under it and removed after the train).
# Must not be under /dev or /sys.
LAND_TMP=/path/to/lander-tmp

# Directory put first on PATH: guard wrappers for kill, pkill, killall and pgrep. Empty directory is fine.
LAND_GUARD_BIN=/path/to/guard-bin

# Cache of the QEMU kernels, keyed by the inputs of each build. A symlink to another disk is fine.
LAND_QK_DIR=/path/to/lander-cache/qk

# Directory holding a copy of the pinned kernel tarball. When the tarball is missing there, the kernel
# build downloads it from the official source and checks its hash.
LAND_KERNEL_TARBALLS=/path/to/lander-cache/tarballs

# BusyBox build directory for the gate (BUSYBOX_DIR).
LAND_BUSYBOX_DIR=/path/to/lander-cache/busybox

# Consumer compile: its work, targets and lock.
LAND_CC_WORK=/path/to/lander-cc-work

# Consumer compile: its cache (locks per pinned rev, baselines per base).
LAND_CC_CACHE=/path/to/lander-state/cc-cache

# Consumer compile: the consumer data directory, which holds consumers.tsv, shims.tsv, fields.tsv and fixes/.
# setup writes it from scripts/land/consumers/ (in git), with each consumer's checkout found on this machine.
LAND_CC_DATA=/path/to/consumer-data

# The remote the lander fetches from and pushes next to: a remote name (origin) or a URL or path to a
# bare repository (a rehearsal).
LAND_REMOTE=origin

# GitHub owner/repo whose open pr/<id> PRs are closed when a PR lands. Empty closes none.
LAND_PR_REPO=owner/repo

# Prefix of the systemd unit name. land.sh <suffix> runs the unit <prefix><suffix>.
LAND_UNIT_PREFIX=ltrain-

# Optional nice value for the unit. Leave it unset to run at the default.
# LAND_UNIT_NICE=10

# CPU sets (taskset -c) for each lane. Keep them disjoint if the lanes must not compete.
LAND_CPUS_GATE=6-23
LAND_CPUS_CC=6-23
LAND_CPUS_QEMU=24-27
LAND_CPUS_OFF=28-31

# Build jobs. Gate: CARGO_BUILD_JOBS for the gate. Kernel: JOBS for the QEMU kernel build.
# QEMU and QEMU cargo: JOBS and CARGO_BUILD_JOBS for the modules harness. Off: CARGO_BUILD_JOBS for the
# modules-off lane. CC: CARGO_BUILD_JOBS for the consumer compile.
LAND_JOBS_GATE=12
LAND_JOBS_KERNEL=12
LAND_JOBS_QEMU=8
LAND_JOBS_QEMU_CARGO=4
LAND_JOBS_OFF=6
LAND_JOBS_CC=4
