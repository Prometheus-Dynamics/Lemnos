# The functions liblemnos_capi exports: the C surface in include/lemnos.h,
# one name per line. src/tests.rs checks this list against the header and
# against the crate's exported functions, so the three stay in step.
# Surface 1.0; the shared library's SONAME is liblemnos_capi.so.1.
lemnos_version
lemnos_check_version
lemnos_client_open
lemnos_client_close
lemnos_device_count
lemnos_device_info
lemnos_channel_info
lemnos_read
lemnos_subscribe
lemnos_next_reading
