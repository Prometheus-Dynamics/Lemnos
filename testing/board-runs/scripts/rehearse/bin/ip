#!/usr/bin/env bash
# Stand-in ip: the link interface has its address while the gadget is bound.
. "$(dirname "$0")/../world.sh"
calls "ip $*"
case "$*" in
*"addr show"*)
  # systemd-networkd applies the runtime .network file again when the interface comes back,
  # unless the rehearsal broke it (world/networkd.broken); then only a hand re-add brings it.
  if [ -s "$GADGET_DIR/UDC" ] && { [ ! -e "$W/networkd.broken" ] || [ -e "$W/link.readded" ]; }; then
    echo "5: lemnos0    inet 10.55.0.1/29 brd 10.55.0.7 scope global lemnos0"
  fi
  exit 0 ;;
*"addr add"*) : >"$W/link.readded"; exit 0 ;;
esac
