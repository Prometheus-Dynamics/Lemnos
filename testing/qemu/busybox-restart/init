#!/bin/sh
# The initramfs's /init (testing/qemu/run-busybox-restart.sh). The kernel starts this shell as PID 1; it mounts what BusyBox
# init and the restart helper need, then execs BusyBox init, which replaces it as PID 1.
mount -t devtmpfs devtmpfs /dev 2>/dev/null || echo "BUSYBOX-RESTART-GUEST init: no devtmpfs"
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /run /tmp
echo "BUSYBOX-RESTART-GUEST boot: exec /sbin/init"
exec /sbin/init
