#!/bin/bash
# The initramfs's /init (testing/qemu/run-gadget-keep.sh). systemd's early /dev mount fails on the initramfs's own
# rootfs, so the guest moves into a tmpfs root (/newroot) and runs systemd there, as PID 1, by chroot.
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev || echo "init: no devtmpfs"
mkdir -p /newroot
mount -t tmpfs -o mode=0755,size=300m tmpfs /newroot || { echo "init: no tmpfs root"; exec /bin/sh; }
for entry in /* ; do
	case "$entry" in
	/newroot|/proc|/sys|/dev|/init) continue ;;
	esac
	cp -a "$entry" /newroot/
done
mkdir -p /newroot/dev /newroot/proc /newroot/sys /newroot/run /newroot/tmp
mount --bind /dev /newroot/dev
# sysfs and configfs before systemd, as an image's initramfs has them: the gadget's tree is made in configfs, and
# systemd keeps API file systems it finds mounted.
mount -t sysfs sys /newroot/sys
mount -t configfs configfs /newroot/sys/kernel/config || echo "init: no configfs"
echo "init: the guest's root is /newroot; starting systemd"
exec chroot /newroot /usr/lib/systemd/systemd
