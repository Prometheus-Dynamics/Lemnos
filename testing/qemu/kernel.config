# What the guest needs on top of the default configuration.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_COMMON_CLK=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_PWM=y
CONFIG_I2C=y
CONFIG_I2C_STUB=m
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_LOOPBACK_TEST=m
# The simulated interrupt controller has no option of its own; this selects it.
CONFIG_CONFIGFS_FS=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SIM=y
# Catches what a passing run wouldn't show.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_KASAN=y
