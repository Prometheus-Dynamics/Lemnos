# What the guest needs on top of the default configuration.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_COMMON_CLK=y
# lemnos.ko's required symbols (docs/kernel-config.md, checked by scripts/check-kernel-config.py).
CONFIG_PM=y
CONFIG_OF=y
CONFIG_EVENTFD=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_PWM=y
CONFIG_REGULATOR=y
CONFIG_RESET_CONTROLLER=y
CONFIG_THERMAL=y
CONFIG_I2C=y
CONFIG_I2C_STUB=m
CONFIG_I2C_CHARDEV=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_LOOPBACK_TEST=m
CONFIG_SPI_SPIDEV=y
# The simulated interrupt controller has no option of its own; this selects it.
CONFIG_CONFIGFS_FS=y
# The USB gadget check (testing/crates/gadget-check): dummy_hcd is the host and the gadget at once,
# with the composite gadget from configfs, FunctionFS, and the NCM and ACM functions. usbfs (always
# built with USB) is how the host side reaches the device.
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DUMMY_HCD=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SIM=y
# Catches what a passing run wouldn't show.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_KASAN=y
