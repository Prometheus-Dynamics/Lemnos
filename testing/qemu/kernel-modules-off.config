# The kernel for an image with no loadable modules: lemnos built in (CONFIG_LEMNOS, see
# build-kernel.sh --modules-off), and everything it needs built in too. The same guest
# configuration as kernel.config, with module support off and no test module in the kernel.
# The required symbols of lemnos.ko are listed in docs/kernel-config.md (checked by
# scripts/check-kernel-config.py, which reads this file as well).
# CONFIG_MODULES is not set: the kernel has no module support at all.
# CONFIG_MODULES is not set
CONFIG_LEMNOS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
# The slot board's chain, built in (docs/kernel-config.md, "Slot board: built in").
CONFIG_BLOCK=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_BUFIO=y
CONFIG_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_COMMON_CLK=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_PWM=y
CONFIG_REGULATOR=y
CONFIG_RESET_CONTROLLER=y
CONFIG_THERMAL=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_SPIDEV=y
CONFIG_CONFIGFS_FS=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_SIM=y
# lemnos.ko's required symbols (docs/kernel-config.md).
CONFIG_PM=y
CONFIG_OF=y
CONFIG_EVENTFD=y
# Catches what a passing run wouldn't show.
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_KASAN=y
